digraph unnamed {
    Node0 [shape=record,label="{ [B0]\l}" ];
    Node1 [shape=record,label="{ [B1]\l   1: return w;\l}" ];
    Node2 [shape=record,label="{ [B2]\l   1: x = _Cilk_spawn fib(n - 1);\l   2: y = _Cilk_spawn fib(n - 2);\l   T: sync\l}" ];
    Node3 [shape=record,label="{ [B3]\l   1: a = _Cilk_spawn fib(x - 1);\l   2: z = _Cilk_spawn fib(n - 3);\l   T: sync\l}" ];
    Node4 [shape=record,label="{ [B4]\l   1: w = x + y + a * z;\l}" ];
    Node5 [shape=record,label="{ [B5]\l   1: w = n;\l}" ];
    Node6 [shape=record,label="{ [B6]\l   1: long w;\l   2: n \< 2;\l   T: if (n \< 2)\l}" ];
    Node7 [shape=record,label="{ [B7]\l}" ];
    Node8 [shape=record,label="{ [B8]\l   1: return w;\l}" ];
    Node9 [shape=record,label="{ [B9]\l}" ];
    Node0 -> Node1;
    Node1 -> Node0;
    Node1 -> Node5;
    Node2 -> Node3;
    Node2 -> Node6;
    Node3 -> Node4;
    Node3 -> Node2;
    Node4 -> Node8;
    Node4 -> Node3;
    Node5 -> Node1;
    Node5 -> Node6;
    Node6 -> Node2;
    Node6 -> Node5;
    Node6 -> Node7;
    Node7 -> Node6;
    Node8 -> Node0;
    Node8 -> Node4;
}